# Richard -- claude-code-telegram safety-net agent config
# Generated by neurootdel-install

# Telegram
TELEGRAM_BOT_TOKEN={{RICHARD_BOT_TOKEN}}
TELEGRAM_BOT_USERNAME={{RICHARD_BOT_USERNAME}}

# Model: an explicit id (installer NEUROOTDEL_DOCTOR_MODEL); empty would mean the SDK default.
CLAUDE_MODEL={{DOCTOR_MODEL}}

# His own runtime loads the rules (read by richard_launch.py): settings/CLAUDE.md sources of the
# SDK (user = ~/.claude: global rules and hooks; project = his working dir) and his role file.
RICHARD_SETTING_SOURCES=user,project
RICHARD_ROLE_FILE={{RICHARD_HOME}}/DOCTOR.md

# Auth: empty API key + USE_SDK=true -> Claude CLI OAuth from ~/.claude/
USE_SDK=true
ANTHROPIC_API_KEY=
CLAUDE_CLI_PATH=

# Access control
ALLOWED_USERS={{TG_USER_ID}}
APPROVED_DIRECTORY=/home/{{USER}}

# Hardening (audit C3 fix)
ENVIRONMENT=production
DEVELOPMENT_MODE=false
DISABLE_TOOL_VALIDATION=false
ENABLE_MCP=false

# Tool allowlist (audit C3 fix -- conservative default)
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,LS,Task,WebFetch,WebSearch
